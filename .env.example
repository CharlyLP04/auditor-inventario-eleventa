# Modo equipo (Firebase). Copia este archivo como .env.local y completa los valores
# de tu proyecto (Configuración del proyecto → Tus apps → Web). No son secretos:
# la seguridad la dan las reglas de Firestore. Sin VITE_FIREBASE_PROJECT_ID la app
# funciona solo en modo local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Solo para pruebas locales con los emuladores (npm run test:cloud usa demo-auditor):
# VITE_FIREBASE_EMULATOR=true
