{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "database": "(default)",
    "location": "us-central1",
    "edition": "standard"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "auth": {
    "authorizedDomains": [
      "localhost",
      "grid-auditor-eleventa.firebaseapp.com",
      "grid-auditor-eleventa.web.app",
      "auditor-inventario-eleventa.vercel.app"
    ],
    "providers": {
      "emailPassword": true
    }
  }
}
